# Sao chép file này thành ".env" rồi điền token của bạn.
# Copy this file to ".env" and fill in your token. Never commit .env.

# Personal access token (Figma → Settings → Security → Personal access tokens)
FIGMA_ACCESS_TOKEN=figd_your_token

# Optional: team ID for team library search (figma.com/files/team/<id>/…)
# FIGMA_TEAM_ID=

# Optional: where plugin-rendered screenshots and assets are saved
# FIGMA_ASSET_DIR=

# Optional: tool-name prefix (default figma_local_; empty = official names)
# FIGMA_TOOL_PREFIX=figma_local_
