{
  "name": "figma-mcp",
  "version": "0.1.0",
  "description": "Self-hosted Figma MCP server that mirrors the official Figma MCP tool interface, backed by the Figma REST API and a companion plugin bridge.",
  "type": "module",
  "bin": {
    "figma-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "plugin"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/ws": "^8.18.2",
    "typescript": "^5.9.3"
  }
}
